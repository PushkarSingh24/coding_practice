import java.util.*;
public class main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        HashSet<Integer> set = new HashSet<>();
        for(int i = 0; i<4; i++){
            int x= sc.nextInt();
            set.add(x);
        }
        System.out.println(4 - set.size());
        sc.close();
    }
}